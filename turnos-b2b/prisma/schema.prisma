generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  role         Role    @default(STAFF)
  tenantId     String?
  tenant       Tenant? @relation(fields: [tenantId], references: [id])
}

model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  users     User[]
  resources Resource[]
  services  Service[]
  bookings  Booking[]
}

model Resource {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  name     String
  type     ResourceType
  services Service[]
  bookings Booking[]
}

model Service {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  name        String
  durationMin Int
  resources   Resource[]
  bookings    Booking[]
}

model Booking {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  resourceId    String
  resource      Resource      @relation(fields: [resourceId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  customerName  String
  customerPhone String?
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(CONFIRMED)
}

enum Role {
  OWNER
  STAFF
}

enum ResourceType {
  STAFF
  FACILITY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}
